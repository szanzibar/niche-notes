# The Arch package, made in CI from the .deb that Ubuntu built. openssl-3, since that OpenSSL is a major behind Arch's.
pkgname=niche-notes
pkgver=${PKGVER:?}
pkgrel=1
arch=(x86_64)
options=(!debug)
# WebKitGTK checks spelling only with a dictionary for one of the system's languages.
depends=(webkit2gtk-4.1 gtk3 openssl-3 hunspell-en_us)
optdepends=('hunspell-de: German spell checking, with German in the system languages')
source=(niche-notes-linux.deb)
sha256sums=(SKIP)

package() {
  bsdtar -xf data.tar.gz -C "$pkgdir"
  # KWin finds a window's icon by the launcher named after its app_id, which is the binary's name.
  mv "$pkgdir/usr/share/applications/Niche Notes.desktop" "$pkgdir/usr/share/applications/niche-notes.desktop"
}
