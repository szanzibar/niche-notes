<?xml version="1.0" encoding="utf-8"?>
<!-- A Due widget's line, in line with its note's title, with its date under it. The box's padding makes it big enough
     for a finger, and the text's padding puts its first line beside the box. Baseline alignment would cut off its
     other lines. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/box"
        android:layout_width="22dp"
        android:layout_height="30dp"
        android:contentDescription="@string/done"
        android:paddingVertical="8dp"
        android:paddingEnd="8dp"
        android:src="@drawable/widget_unchecked" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="5dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/widget_ink" />

        <TextView
            android:id="@+id/date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
