# Copy to .env next to docker-compose.yml. A TLS proxy in front of 127.0.0.1:$PORT is expected.
PHX_HOST=
PORT=4000
SECRET_KEY_BASE=      # openssl rand -base64 64 | tr -d '\n'
POCKET_ID_URL=
OIDC_CLIENT_ID=       # from the OIDC client you create in Pocket ID
OIDC_CLIENT_SECRET=
# The Android app: its id, and its signing key from `keytool -list -v`. Leave empty without the app.
ANDROID_APP_ID=
ANDROID_CERT_SHA256=
